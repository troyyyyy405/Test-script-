    BackgroundTransparency = 1
}, frame))

local buttonHolder = layout.Parent

local function addButton(text, callback)
    local btn = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        Text = text,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamSemibold,
        TextSize = 14
    }, buttonHolder)

    make("UICorner", {
        CornerRadius = UDim.new(0, 8)
    }, btn)

    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- Speed
local speedButton

speedButton = addButton("Speed: 16", function()
    speed = speed + 10
    if speed > 100 then speed = 16 end

    if humanoid then
        humanoid.WalkSpeed = speed
    end

    speedButton.Text = "Speed: " .. speed
end)

-- Fly
local flyButton

flyButton = addButton("Fly: OFF", function()
    flying = not flying

    if flying then
        getCharacter()

        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = root

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bodyGyro.P = 10000
        bodyGyro.Parent = root

        flyConnection = RunService.RenderStepped:Connect(function()
            if not flying or not root.Parent then return end

            local camera = workspace.CurrentCamera
            local move = humanoid.MoveDirection

            local vertical = 0
            if UIS:IsKeyDown(Enum.KeyCode.Space) then
                vertical = 1
            elseif UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
                vertical = -1
            end

            bodyVelocity.Velocity =
                move * flySpeed
                + Vector3.new(0, vertical * flySpeed, 0)

            bodyGyro.CFrame = camera.CFrame
        end)
    else
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end

        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
    end

    flyButton.Text = "Fly: " .. (flying and "ON" or "OFF")
end)

-- Noclip
local noclipButton

noclipButton = addButton("Noclip: OFF", function()
    noclip = not noclip

    noclipButton.Text = "Noclip: " .. (noclip and "ON" or "OFF")

    if not noclip and character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    if noclip and character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Anti hit: requests server-authorized protection
local hitButton

hitButton = addButton("Anti-Hit: OFF", function()
    antiHit = not antiHit
    hitButton.Text = "Anti-Hit: " .. (antiHit and "ON" or "OFF")

    adminRemote:FireServer("AntiHit", antiHit)
end)

-- Teleport to a designated spawn
addButton("Teleport to Spawn", function()
    local spawnLocation = workspace:FindFirstChildWhichIsA("SpawnLocation", true)

    if spawnLocation and root then
        root.CFrame = spawnLocation.CFrame + Vector3.new(0, 4, 0)
    end
end)

-- Egg recovery: ask the server to release any stuck egg transaction
addButton("Recover Stuck Egg", function()
    eggRemote:FireServer("Recover")
end)

-- Auto-farm: server-controlled, game-specific
local autoFarm = false
local farmButton

farmButton = addButton("Auto Farm: OFF", function()
    autoFarm = not autoFarm

    farmButton.Text = "Auto Farm: " .. (autoFarm and "ON" or "OFF")

    adminRemote:FireServer("AutoFarm", autoFarm)
end)

-- Reset movement
addButton("Reset Movement", function()
    flying = false
    noclip = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end

    if humanoid then
        humanoid.WalkSpeed = 16
    end

    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end

    flyButton.Text = "Fly: OFF"
    noclipButton.Text = "Noclip: OFF"
end)
